[
  { "name": "one failure alone does not rest the model",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-a" },
    "response": { "model": "cb-a" },
    "status": 500 },
  { "name": "so the next request for it is sent on",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-a" } },

  { "name": "the second failure inside the window rests the model",
    "options": { "failures": 2, "cooldown": 60 },
    "response": { "model": "cb-b" },
    "status": 500 },
  { "name": "…and it is the second one that does it",
    "options": { "failures": 2, "cooldown": 60 },
    "response": { "model": "cb-b" },
    "status": 500 },
  { "name": "a request to a resting model is refused with 429",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-b" },
    "reject": { "status": 429, "message": "cb-b is resting" } },
  { "name": "the refusal names the model and the seconds left",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-b" },
    "reject": { "status": 429, "message": "60s left" } },

  { "name": "message is the refusal's whole text",
    "options": { "failures": 1, "cooldown": 60, "message": "cb-c is down; try another model" },
    "response": { "model": "cb-c" },
    "status": 503 },
  { "name": "…used in place of the default one",
    "options": { "failures": 1, "cooldown": 60, "message": "cb-c is down; try another model" },
    "request": { "model": "cb-c" },
    "reject": { "status": 429, "message": "cb-c is down; try another model" } },

  { "name": "a status outside status is not a failure",
    "options": { "failures": 1, "cooldown": 60, "status": [503] },
    "response": { "model": "cb-d" },
    "status": 500 },
  { "name": "so that model is not resting",
    "options": { "failures": 1, "cooldown": 60, "status": [503] },
    "request": { "model": "cb-d" } },

  { "name": "a failure is counted",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-e" },
    "response": { "model": "cb-e" },
    "status": 500 },
  { "name": "a good reply in between clears the count",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-e" },
    "response": { "model": "cb-e" },
    "status": 200 },
  { "name": "so the failure after it is a first one again",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-e" },
    "response": { "model": "cb-e" },
    "status": 500 },
  { "name": "…and the model is still not resting",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-e" } },

  { "name": "a streamed error event counts as a failure",
    "options": { "failures": 1, "cooldown": 60 },
    "request": { "model": "cb-f" },
    "events": [{ "event": "error", "data": { "type": "error", "error": { "status": 500 } } }] },
  { "name": "so a stream that failed rests the model",
    "options": { "failures": 1, "cooldown": 60 },
    "request": { "model": "cb-f" },
    "reject": { "status": 429, "message": "cb-f is resting" } },

  { "name": "a stream that opened and died answers nothing",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-g" },
    "events": [{ "event": "error", "data": { "type": "error", "error": { "status": 500 } } }] },
  { "name": "…so its opening events leave the count where it was",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-g" },
    "events": [
      { "event": "message_start", "data": { "type": "message_start" } },
      { "event": "ping", "data": { "type": "ping" } }] },
  { "name": "…so the failure after it is the second one",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-g" },
    "response": { "model": "cb-g" },
    "status": 500 },
  { "name": "…and the model rests",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-g" },
    "reject": { "status": 429, "message": "cb-g is resting" } },

  { "name": "a streamed answer counts as a good reply",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-h" },
    "events": [
      { "event": "error", "data": { "type": "error", "error": { "status": 500 } } },
      { "event": "content_block_delta", "data": { "type": "content_block_delta", "index": 0, "delta": { "type": "text_delta", "text": "hi" } } },
      { "event": "error", "data": { "type": "error", "error": { "status": 500 } } }] },
  { "name": "…so the failure after it is a first one again",
    "options": { "failures": 2, "cooldown": 60 },
    "request": { "model": "cb-h" } },

  { "name": "a reply that names its own model is counted for it",
    "options": { "failures": 1, "cooldown": 60 },
    "response": { "response": { "model": "cb-i" } },
    "status": 500 },
  { "name": "…and the request for that model is refused",
    "options": { "failures": 1, "cooldown": 60 },
    "request": { "model": "cb-i" },
    "reject": { "status": 429 } },

  { "name": "a request with no model goes on untouched",
    "request": { "messages": [] } },

  { "name": "two failures is what the defaults rest a model on",
    "response": { "model": "cb-j" },
    "status": 500 },
  { "name": "…the first one alone does not",
    "request": { "model": "cb-j" } },
  { "name": "…the second one does",
    "response": { "model": "cb-j" },
    "status": 500 },
  { "name": "…and the default refusal is the one naming the model",
    "request": { "model": "cb-j" },
    "reject": { "status": 429, "message": "cb-j is resting" } },

  { "name": "junk options fall back to the defaults",
    "options": { "failures": 0, "window": -5, "cooldown": "soon", "max": null, "status": "500", "message": 7 },
    "response": { "model": "cb-k" },
    "status": 500 },
  { "name": "…so two failures still rest it, window and cooldown being the defaults",
    "options": { "failures": 0, "window": -5, "cooldown": "soon", "max": null, "status": "500", "message": 7 },
    "response": { "model": "cb-k" },
    "status": 500 },
  { "name": "…and the refusal is the default one, a message that is not a string being ignored",
    "options": { "failures": 0, "window": -5, "cooldown": "soon", "max": null, "status": "500", "message": 7 },
    "request": { "model": "cb-k" },
    "reject": { "status": 429, "message": "cb-k is resting" } },

  { "name": "an empty status list leaves the default one in place",
    "options": { "failures": 2, "cooldown": 60, "status": [] },
    "response": { "model": "cb-l" },
    "status": 500 },
  { "name": "…so two failures still rest that model",
    "options": { "failures": 2, "cooldown": 60, "status": [] },
    "response": { "model": "cb-l" },
    "status": 500 },
  { "name": "…and it is the one refused",
    "options": { "failures": 2, "cooldown": 60, "status": [] },
    "request": { "model": "cb-l" },
    "reject": { "status": 429, "message": "cb-l is resting" } },

  { "name": "a model that rests leaves every other model alone",
    "options": { "failures": 1, "cooldown": 60 },
    "response": { "model": "cb-m" },
    "status": 500 },
  { "name": "…the one it happened to is refused",
    "options": { "failures": 1, "cooldown": 60 },
    "request": { "model": "cb-m" },
    "reject": { "status": 429 } },
  { "name": "…and another model is sent on untouched",
    "options": { "failures": 1, "cooldown": 60 },
    "request": { "model": "cb-m-2" } }
]
